<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/my_main_color"
    tools:context=".Suttas.SuttasOpenActivity">

    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="51dp"
        android:layout_height="39dp"
        android:layout_marginBottom="10dp"
        android:background="@color/my_main_color"
        android:contentDescription="возврат в главное меню"
        android:onClick="toSuttasOpenBack"
        android:scaleType="centerInside"
        android:src="@drawable/button_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0"
        tools:ignore="UsingOnClickInXml" />


    <ScrollView
        android:id="@+id/viewScrollSuttasOpen"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@+id/backButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/linearLayoutScrollSuttasOpen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imageVievSuttasOpen1"
                style="@style/imageViewRazdelitelKnopok"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/textViewSuttasOpen"
                style="@style/textBetweenButtons"
                android:text="@string/forTextViewsuttasOpen" />

            <Button
                android:id="@+id/button_suttas_open_digha"
                style="@style/button_activity_declomation_main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:onClick="toSuttasOpenDighaAct"
                android:text="@string/button_text_suttas_open_digha" />

            <Button
                android:id="@+id/button_suttas_open_majhima"
                style="@style/button_activity_declomation_main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:onClick="toSuttasOpenMajhimaAct"
                android:text="@string/button_text_suttas_open_madjhima" />

            <Button
                android:id="@+id/button_suttas_open_sanutta"
                style="@style/button_activity_declomation_main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:onClick="toSuttasOpenSanuttaAct"
                android:text="@string/button_text_suttas_open_sanutta" />

            <Button
                android:id="@+id/button_suttas_open_anguttara"
                style="@style/button_activity_declomation_main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:onClick="toSuttasOpenAnguttaraAct"
                android:text="@string/button_text_suttas_open_anguttara" />

            <Button
                android:id="@+id/button_suttas_open_kuddaka"
                style="@style/button_activity_declomation_main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:onClick="toSuttasOpenKuddakaAct"
                android:text="@string/button_text_suttas_open_kuddaka" />
            <Button
                android:id="@+id/button_suttas_open_search"
                style="@style/button_activity_declomation_main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#FFAB91"
                android:onClick="toSuttasOpenSearchAct"
                android:text="@string/button_text_suttas_open_search" />

            <ImageView
                android:id="@+id/imageVievSuttasOpen2"
                style="@style/imageViewRazdelitelKnopok"
                tools:ignore="ContentDescription" />
            <Button
                android:id="@+id/button_suttas_open_random_sutta"
                style="@style/button_activity_declomation_main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#FFAB91"
                android:onClick="toSuttasOpenRandomSuttaAct"
                android:text="@string/button_text_suttas_open_random_sutta" />
            <Button
                android:id="@+id/button_suttas_open_bookmarks"
                style="@style/button_activity_declomation_main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#66BB6A"
                android:onClick="toSuttasOpenBookmarksAct"
                android:text="@string/button_text_suttas_open_bookmarks" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cardViewSuttasOpen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/my_main_color"
                app:cardElevation="0dp"
                app:cardMaxElevation="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/viewScrollSuttas"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.06"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="1.0">

                <ImageView
                    android:id="@+id/imageView14"
                    android:layout_width="29dp"
                    android:layout_height="47dp"
                    android:layout_gravity="right|left"
                    app:srcCompat="@drawable/stupa_color" />

                <TextView
                    android:id="@+id/textViewSuttasOpenAct"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="right|left"
                    android:layout_marginLeft="38dp"
                    android:layout_marginTop="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:linksClickable="true"
                    android:text="@string/openSuttas"
                    android:textColor="@color/my_text_bacground_color"
                    android:textSize="14sp" />

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

    <WebView
        android:id="@+id/webViewSuttasOpen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="vertical"
        android:visibility="invisible"
        android:scrollbarThumbVertical="@android:color/holo_red_dark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Включаем макет с кнопками -->
    <include
        layout="@layout/buttons_layout_for_suttas_open"
        />

</androidx.constraintlayout.widget.ConstraintLayout>